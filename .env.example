# =========================================================================
# Multi-Account API Credentials & Notification Template (.env.example)
# =========================================================================

ACTIVE_USER=dxmade@gmail.com

# -------------------------------------------------------------------------
# Telegram Bot Alerts & Two-Way Remote Control
# -------------------------------------------------------------------------
# Dapatkan token dari @BotFather di Telegram (contoh: 123456789:ABCdefGHI...)
TELEGRAM_BOT_TOKEN=
# Dapatkan Chat ID Anda dari @userinfobot di Telegram (contoh: 987654321)
TELEGRAM_CHAT_ID=

# -------------------------------------------------------------------------
# Binance Futures API (Testnet / Demo & Live)
# -------------------------------------------------------------------------
# Testnet Demo Trading (Bebas Risiko)
BINANCE_DEMO_API_KEY_DXMADE_GMAIL_COM=your_binance_testnet_key_here
BINANCE_DEMO_API_SECRET_DXMADE_GMAIL_COM=your_binance_testnet_secret_here

# Live Trading (Opsional)
# BINANCE_API_KEY_DXMADE_GMAIL_COM=your_binance_live_key_here
# BINANCE_API_SECRET_DXMADE_GMAIL_COM=your_binance_live_secret_here

# -------------------------------------------------------------------------
# Sentry Error Tracking & Performance Observability (Optional)
# -------------------------------------------------------------------------
# Sentry DSN dari project Sentry Anda (contoh: https://xyz@o123456.ingest.us.sentry.io/7890123)
SENTRY_DSN=
# Environment: production, development, or testnet
SENTRY_ENVIRONMENT=production
# Sample rate tracing & profiling (1.0 = 100% telemetry, 0.2 = 20%)
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
